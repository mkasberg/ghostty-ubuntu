#!/usr/bin/make -f
VERSION=0.17

export DEB_BUILD_MAINT_OPTIONS=hardening=+all
export ZIG_GLOBAL_CACHE_DIR=/tmp/zig-cache
%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	ln -s /usr/lib/llvm-22/lib/clang/22/include/ lib/
	# without specifying MCPU, it targets native
	#	we want to specify -DZIG_TARGET_TRIPLE=$(DEB_HOST_MULTIARCH), but it breaks PIE
	dh_auto_configure -- \
		-DZIG_PIE=ON \
		-DZIG_SHARED_LLVM=ON \
		-DZIG_TARGET_MCPU=baseline

# output of build is stage3/bin and stage3/lib
export BBASE:=obj-$(DEB_HOST_MULTIARCH)/stage3

# make a man page and move the docs to usr/share/doc
override_dh_auto_install:
	help2man -s 1 -N -n "zig compiler and build tool" -v version $(BBASE)/bin/zig -o zig$(VERSION).1
	mkdir -p debian/tmp/usr/share/doc/zig$(VERSION)
	if [ -d "$(BBASE)/lib/zig/docs" ] && [ -n "$$(ls -A $(BBASE)/lib/zig/docs)" ]; then mv $(BBASE)/lib/zig/docs/* debian/tmp/usr/share/doc/zig$(VERSION)/; fi
	if [ -d "$(BBASE)/lib/zig/docs" ]; then rmdir $(BBASE)/lib/zig/docs; fi
	dh_auto_install
	# Upstream 0.17 installs langref.html to usr/doc via cmake install;
	# consolidate it under usr/share/doc/zig$(VERSION)
	if [ -d debian/tmp/usr/doc ] && [ -n "$$(ls -A debian/tmp/usr/doc)" ]; then mv debian/tmp/usr/doc/* debian/tmp/usr/share/doc/zig$(VERSION)/; fi
	if [ -d debian/tmp/usr/doc ]; then rmdir debian/tmp/usr/doc; fi

	# dh_shlibdeps fails to get dependency information for /usr/lib/llvm-22/lib/libLLVM.so.22.1
	# llvm-22-dev is explicitly added as a runtime dependency of zig0.17
	chrpath -d debian/tmp/usr/bin/zig

	# Create symlink /usr/bin/zig0.17
	ln -s ../lib/zig0.17/bin/zig debian/tmp/usr/bin/zig0.17

override_dh_auto_test:
	$(BBASE)/bin/zig test test/behavior.zig
	dh_auto_test
